# --- Telegram -----------------------------------------------------------------
TELEGRAM_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
ALLOWED_USER_IDS=
# Optional comma-separated chat IDs. Leave empty to allow any chat from allowed users.
ALLOWED_CHAT_IDS=

# Password gate required before generating a report.
BOT_PASSWORD=

# --- AI provider: openai | ollama ------------------------------------------
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=llava

# --- Limits ----------------------------------------------------------------
MAX_RECEIPTS=20
MAX_FILE_SIZE_MB=10

# --- Paths, timeouts & retries ---------------------------------------------
TEMP_DIR=./temp
DATA_DIR=./data
AI_TIMEOUT_SECONDS=60
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_DELAY=1.0
AI_CONCURRENCY=2
MAX_PROCESSING_SECONDS=300
TELEGRAM_TIMEOUT_SECONDS=30
SESSION_TTL_SECONDS=1800

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Report metadata -------------------------------------------------------
REPORT_TITLE=Heading Travel Expenses
REPORT_PERIOD=July Expenses
